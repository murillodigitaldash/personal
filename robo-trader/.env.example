# Copie para .env e preencha. O .env esta no .gitignore e nao deve ser comitado.
# Nunca compartilhe estes valores por chat, issue ou commit.

ROBO_TRADER_EXCHANGE=binance

# Credenciais da corretora.
# Em modo testnet, use as chaves da testnet (sao separadas das reais):
# Binance spot testnet -> https://testnet.binance.vision
ROBO_TRADER_API_KEY=
ROBO_TRADER_API_SECRET=

# Homologacao: 1 manda as ordens para a testnet, com saldo ficticio.
ROBO_TRADER_TESTNET=1

# Trava do dinheiro real: o modo live so envia ordem com esta variavel em 1
# E com enabled=True no codigo. Mantenha em 0 ate ter homologado na testnet.
ROBO_TRADER_ALLOW_LIVE=0
